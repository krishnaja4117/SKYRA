PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Connection (Safe placeholder - do NOT put production credentials here)
MONGODB_URI=mongodb://localhost:27017/skyra

# ML Service URL
ML_SERVICE_URL=http://127.0.0.1:8000

# Reserved for later weather/API integrations. Not used by the risk engine yet.
OPENWEATHER_API_KEY=

# Pinecone Cloud Vector Store (Optional - defaults to local FAISS when disabled or unconfigured)
PINECONE_ENABLED=false
PINECONE_API_KEY=
PINECONE_INDEX_NAME=skyra-disaster-kb
PINECONE_NAMESPACE=default
PINECONE_DIMENSION=1536

# Bhashini Indian Language AI Platform (MeitY) (Optional - defaults to browser Web Speech API & local fallback when unconfigured)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_KEY=
BHASHINI_PIPELINE_ID=
